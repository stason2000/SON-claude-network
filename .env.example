# 이름만 있는 템플릿. 실제 값은 .env(깃에 올라가지 않음)에 직접 입력. 채팅에 붙여넣지 말 것.
# 필요한 것만 채우면 된다. 비워두면 해당 기능만 꺼진다.

# --- 무료 AI 게이트웨이(OmniRoute) 뒤에 붙일 무료 API 키 (선택) ---
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- 자동매매: 반드시 testnet/모의투자 키부터. 권한은 조회+거래만, 출금 금지, IP 제한 ---
EXCHANGE_TESTNET_API_KEY=
EXCHANGE_TESTNET_API_SECRET=
# 실거래 키는 모의 검증 2~4주 통과 전에는 만들지 않는다.
