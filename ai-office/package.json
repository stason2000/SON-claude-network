{
  "name": "ai-office",
  "version": "0.1.0",
  "private": true,
  "description": "AI OFFICE - 개인용 AI 자율 업무 시스템 (1단계: 기본 대시보드와 작업 상태 관리 기반)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
