# AI OFFICE 환경 설정 예시. 이 파일을 .env 로 복사해서 사용합니다. (.env 는 git에 올라가지 않습니다)
# 1단계에서는 비밀 키가 필요 없습니다. API 키는 2단계부터 이 파일(서버 전용)에만 저장합니다.

# 서버 포트 (기본 4100)
PORT=4100
# 바인딩 주소. 기본 127.0.0.1 (이 컴퓨터에서만 접속). 0.0.0.0 으로 열면 반드시 인증을 먼저 추가해야 합니다.
HOST=127.0.0.1
# DB와 작업 데이터 위치 (기본 ./data)
DATA_DIR=./data
# localhost 외에 허용할 Host 헤더 (쉼표 구분). 예: myserver.local:4100
ALLOWED_HOSTS=
